<project xmlns="http://maven.apache.org/POM/4.0.0"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>

<groupId>pacmanjava</groupId>
<artifactId>pacman</artifactId>
<version>1.0</version>

<properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <main.class>com.seuprojeto.SeuJogoApp</main.class>
    <gluonfx.target>host</gluonfx.target>
</properties>

<dependencies>
<dependency>
    <groupId>com.github.almasb</groupId>
    <artifactId>fxgl</artifactId>
    <version>25</version>
</dependency>
<dependency>
    <groupId>org.jooq</groupId>
    <artifactId>joor</artifactId>
    <version>0.9.16</version>
</dependency>
</dependencies>

<build>
<plugins>
<!-- Plugin para rodar a aplicação direto pelo emulador de terminal -->
<plugin>
<groupId>com.gluonhq</groupId>
    <artifactId>gluonfx-maven-plugin</artifactId>
    <version>1.0.23</version>
    <configuration>
        <target>${gluonfx.target}</target>
        <mainClass>${main.class}</mainClass>
        <attachList>
            <list>display</list>
            <list>lifecycle</list>
            <list>statusbar</list>
            <list>storage</list>
        </attachList>
        <reflectionList>
            <!-- Adicione aqui suas classes de EntityFactory -->
            <list>com.seuprojeto.SuaEntityFactory</list>
        </reflectionList>
        <resourcesList>
            <list>.*\.png$</list>
            <list>.*\.jpg$</list>
            <list>.*\.wav$</list>
            <list>.*\.mp3$</list>
            <list>.*\.tmx$</list>
            <list>.*\.tsx$</list>
            <list>.*\.json$</list>
            <list>.*\.ttf$</list>
        </resourcesList>
    </configuration>
</plugin>
</plugins>
</build>

<profiles>
    <profile>
        <id>android</id>
        <properties>
            <gluonfx.target>android</gluonfx.target>
        </properties>
    </profile>
</profiles>
</project>